# Environment variables for deploying flink-sql-playground (Railway / Fly / Docker).
# Copy to .env for local overrides, or set these in your platform's Variables tab.
# NONE of these are required for local dev — the app runs on defaults (in-memory H2).
# All values below are placeholders; never commit real secrets.

# --- Profile ----------------------------------------------------------------
# Activate the Supabase/PostgreSQL profile for persistent fiddle storage.
# Omit entirely to use the default in-memory H2 (fiddles lost on restart).
QUARKUS_PROFILE=supabase

# --- Supabase / PostgreSQL (only when QUARKUS_PROFILE=supabase) --------------
# Use the Transaction pooler (port 6543 on *.pooler.supabase.com). The profile
# appends ?prepareThreshold=0 automatically — pass the BASE url, no query string.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-password>

# --- Flink runtime tuning (optional; defaults in application.properties) -----
# flink.max-sessions (default 8) — max concurrent user sessions.
FLINK_MAX_SESSIONS=5
# flink.session-idle-timeout (default 3m) — evict idle sessions after this.
FLINK_SESSION_IDLE_TIMEOUT=5m

# --- HTTP -------------------------------------------------------------------
# The platform injects PORT (Railway/Fly); the app binds it, falling back to
# 9090 locally. Normally you do NOT set this yourself.
# PORT=9090

# --- Deployed-build footer (optional build args, not runtime env) ------------
# Set as Docker build args to populate the "deployed build" footer; default
# "unknown". e.g. --build-arg GIT_COMMIT=$(git rev-parse HEAD)
# GIT_COMMIT=
# GIT_BRANCH=
