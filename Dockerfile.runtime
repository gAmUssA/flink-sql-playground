# Packages a prebuilt Quarkus fast-jar (built once, natively, in CI) into the runtime
# image. Only the lightweight copy runs per-architecture, so the arm64 image build does
# not compile Flink under QEMU emulation.
#
# To build straight from source instead (Koyeb, docker compose, local), use the root
# Dockerfile. The fast-jar must already exist at build/quarkus-app/ (run `./gradlew quarkusBuild`).
FROM eclipse-temurin:25.0.2_10-jre
WORKDIR /app
# Run as a non-root user — this process executes untrusted user SQL in-JVM (embedded Flink),
# so dropping root limits the blast radius of any sandbox escape.
RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin appuser
# Copy lib/ first so the dependency layer caches across app-only rebuilds.
COPY --chown=appuser:appuser build/quarkus-app/lib/ ./lib/
COPY --chown=appuser:appuser build/quarkus-app/*.jar ./
COPY --chown=appuser:appuser build/quarkus-app/app/ ./app/
COPY --chown=appuser:appuser build/quarkus-app/quarkus/ ./quarkus/
USER appuser
EXPOSE 9090
ENTRYPOINT ["java", \
    "-Xms768m", \
    "-Xmx1536m", \
    "-XX:+UseZGC", \
    "-XX:MetaspaceSize=128m", \
    "-XX:MaxMetaspaceSize=384m", \
    "-jar", "quarkus-run.jar"]
