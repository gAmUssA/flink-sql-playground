# Packages a prebuilt Quarkus uber-jar (built once, natively, in CI) into the runtime
# image. The uber-jar is a single flat jar — no extraction needed — which avoids running
# a full Gradle/Flink build under QEMU emulation for the arm64 image.
#
# To build straight from source instead (Koyeb, docker compose, local), use the root
# Dockerfile. The jar must already exist at build/*-runner.jar (run `./gradlew quarkusBuild`).
FROM eclipse-temurin:25.0.2_10-jre
WORKDIR /app
# Single flat uber-jar on the system classpath so Flink's MiniCluster can load all
# Flink classes during job-graph deserialization.
COPY build/*-runner.jar app.jar
EXPOSE 9090
ENTRYPOINT ["java", \
    "-Xms768m", \
    "-Xmx1536m", \
    "-XX:+UseZGC", \
    "-XX:+ZGenerational", \
    "-XX:MetaspaceSize=128m", \
    "-XX:MaxMetaspaceSize=384m", \
    "-jar", "app.jar"]
